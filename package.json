{
  "name": "@iyeaaa/page-gate",
  "version": "1.0.0",
  "description": "비밀번호 하나로 Next.js 사이트의 고른 경로를 잠근다 — 서명 쿠키(상태 없음) · scrypt · 대입 제한(메모리/Postgres)",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/iyeaaa/page-gate.git" },
  "engines": { "node": ">=22.18" },
  "files": ["dist", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./next": { "types": "./dist/next.d.ts", "default": "./dist/next.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
    "./stores/postgres": { "types": "./dist/stores/postgres.d.ts", "default": "./dist/stores/postgres.js" }
  },
  "bin": { "page-gate": "dist/cli.js" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "verify": "node verify/run.ts"
  },
  "peerDependencies": { "next": ">=16", "react": ">=19" },
  "peerDependenciesMeta": { "next": { "optional": true }, "react": { "optional": true } },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  }
}
